# Copy this file to .env and fill in your own values.

# --- AI model ---
ANTHROPIC_API_KEY=your-anthropic-api-key
MODEL_NAME=anthropic:claude-sonnet-5

# --- Microsoft Fabric (SQL endpoint) ---
FABRIC_SERVER=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=your-lakehouse-or-warehouse-name
FABRIC_USER=you@yourcompany.com

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=fabric-agent

# --- Azure service principal (optional) ---
# Leave these out to sign in through your browser instead.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
